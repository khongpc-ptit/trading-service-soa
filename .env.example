# Trading Service - Environment Variables Template
# Copy this to .env and configure for local or staging deployment

SERVER_PORT=8083

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://trading_user:trading_pass@localhost:5432/trading_db?schema=public

# Kafka Broker Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# JWT RS256 Authentication (Verification Only)
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ISSUER=urn:soa:user-service
JWT_AUDIENCE=soa-api

# Inter-service URLs
USER_SERVICE_URL=http://localhost:8081
FARMING_SERVICE_URL=http://localhost:8082

# Access-state RPC Timeout (ms, fail-closed on timeout)
ACCESS_STATE_TIMEOUT_MS=1000

# Inter-service Security Keys
SERVICE_KEY_PAYMENT=dev-payment-service-key
SERVICE_KEY_TRADING_TO_FARMING=dev-trading-farming-service-key
SERVICE_KEY_TRADING_TO_USER=dev-trading-user-service-key

# Runtime Environment
NODE_ENV=development
